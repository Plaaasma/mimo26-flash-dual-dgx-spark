# ---- MiMo-V2.6-Flash-RL on 2x DGX Spark: site settings (copy to .env) ----
# This script runs on the HEAD Spark (vLLM rank 0 + the OpenAI API); the worker is driven over ssh.
HEAD_IP=10.0.0.1                 # head's IP on the CX7 link (RoCE); API is served here
WORKER_IP=10.0.0.2               # worker's IP on the CX7 link
WORKER_SSH=user@10.0.0.2         # ssh target for the worker (passwordless)
HEAD_CX7_IF=enp1s0f1np1          # ip -br addr (interface with the link IP)
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1           # ibdev2netdev (HCA behind that interface)
WORKER_CX7_IB=rocep1s0f1
NCCL_IB_GID_INDEX=3              # GID carrying ::ffff:<link ip> (show_gids)

# weights: HF cache snapshot, identical path on both nodes (./start.sh sync copies head -> worker)
MODEL=dealignai/MiMo-V2.6-Flash-RL-UNCENSORED
MODEL_REVISION=0bdb11d7f37d3f6939e53f822c2bff518e4852fa
EXPECTED_SHARDS=65               # model_pp0_ep*_shard0 + model_mtp
HF_TOKEN=

IMAGE=mimo26-sm121:local
BASE_IMAGE=vllm/vllm-openai:mimo-v26-aarch64-cu130
PORT=8888
SERVED_MODEL_NAME=mimo-v2.6-flash
SERVED_MODEL_ALIASES=            # extra model ids, e.g. "glm-5.3-flash" so unchanged clients hit this server
VLLM_API_KEY=

TP=2
NNODES=2
MASTER_PORT=29522

# ---- serving ----
KV_CACHE_DTYPE=fp8               # nvfp4 (packed fp4 + e4m3 block scales, 180 B/token/head: ~1.8x the fp8 pool) / fp8 / auto (bf16)
KV_CACHE_MEMORY=10000000000      # bytes per rank, pinned (empty = --gpu-memory-utilization GPU_MEM_UTIL)
GPU_MEM_UTIL=0.80                # startup gate only when KV_CACHE_MEMORY is set: must be <= device free / total at launch (~0.82-0.85 here)
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=8                   # TritonAttn profile_run on SM12x needs >= 2
MAX_NUM_BATCHED_TOKENS=4096
SPEC_METHOD=dflash               # dflash | mtp | none
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=                 # empty = same as TP
DFLASH_DYNAMIC=                  # e.g. '[[1,2,7],[3,8,3]]' = k=7 for 1-2 running seqs, k=3 for 3-8 (empty = fixed DFLASH_TOKENS)
DFLASH_KV_DTYPE=                 # drafter KV dtype; defaults to fp8 when the target uses nvfp4 (its backend has no fp4 path)
MTP_TOKENS=3
MOE_BACKEND=marlin               # DeepGEMM corrupts fp8 on SM12x, FlashInfer TRTLLM MoE is SM100-only
LINEAR_BACKEND=triton            # CUTLASS c3x fp8 block-scaled GEMM throws "Error Internal" on sm_121 (boot 2); triton = fp8 W8A8 via Triton, marlin = W8A16 fallback
MARLIN_A8=1                      # VLLM_MARLIN_INPUT_DTYPE=fp8: W4A8 Marlin MoE (+15% prefill, decode unchanged)
OPROJ_FP8=0                      # VLLM_MIMO_OPROJ_FP8=1: quantize the bf16 o_proj online (saves ~3 GB/rank of reads)
CUDAGRAPH_MODE=FULL_DECODE_ONLY  # the patched DiffKV builder supports uniform (decode) batches only
CAPTURE_SIZES="1 2 4 8 16 32 64" # DFlash k=7 decode = 8 tokens/seq: 8 seqs x 8 = 64
ASYNC_SCHED=0                    # async scheduling + spec decode corrupts tokens under concurrency (vllm#46669)
THINKING=                        # empty = chat template default (on); false/true = server default enable_thinking
REP_PENALTY=1.05                 # with --generation-config auto: agents that send no sampling params stop looping
LANGUAGE_MODEL_ONLY=0
LIMIT_MM='{"image":800,"video":1,"audio":0}'   # audio 0 skips the audio tower
MM_PROC_KWARGS='{"max_pixels":1048576}'   # 32x32 px per token (patch 16, merge 2): 1024 tokens/image like the GLM setup
SKIP_MM_PROFILING=1
LOAD_FORMAT=instanttensor        # instanttensor (Direct I/O from each node's NVMe, overlay/patch_instanttensor_local.py) | safetensors (mmap, ~8 s/shard)
MIMO26_IT_LOCAL_READS=1          # 1 = each rank reads the whole checkpoint locally (no NCCL all-gather buffers)
EXTRA_ARGS="--mm-processor-cache-type lru --mm-processor-cache-gb 0.5"   # no --prefix-match-unit: MiMo KV groups use 16/32-token blocks

# ---- kernel knobs (forwarded when set) ----
VLLM_DIFFKV_FULL_ATTN_SEGMENTS=64
VLLM_DIFFKV_PREFILL_BLOCK_M=128
VLLM_DIFFKV_SPEC_3D_MAX_Q=16
VLLM_DIFFKV_CUSTOM_PREFILL_MIN_Q=0    # diffbot custom prefill CUDA kernel: passes its unit test on GB10 but corrupts long prompts in-model (boot 19) -> off
VLLM_CA_MAX_SIZE_MB=

# ---- memory rails (Spark unified memory: no OOM killer, an overshoot livelocks the node) ----
MIMO26_ZRAM_ALGO=zstd
MIMO26_ZRAM_GIB=10
MIMO26_POSTLOAD_RECLAIM=4        # GiB of cold pages pushed to zram after the weights land (both nodes)
MIMO26_PREAPI_RECLAIM=3          # ... and after graph capture, before the API server's startup peak
MIMO26_POSTREADY_RECLAIM=3
MIMO26_BOOT_GUARD_MIB=4500       # during boot: reclaim MIMO26_BOOT_GUARD_GIB on a node under this MemAvailable
MIMO26_BOOT_GUARD_GIB=3
MIMO26_WATCHDOG_MIB=1000        # host-side watchdog: kill the local container under this MemAvailable (0 = off)
MIMO26_MIN_BOOT_AVAIL_MIB=104000 # refuse to launch when either node has less available (weights + KV + activations)
READY_TIMEOUT=3600
NCCL_DEBUG=WARN
NCCL_PROTO=                      # empty = NCCL auto (picks LL for 64 KB decode all-reduces); Simple measured 49 vs 62 us at 64 KB, 166 vs 211 us at 384 KB (tests/nccl_lat.sh)
NCCL_ALGO=
